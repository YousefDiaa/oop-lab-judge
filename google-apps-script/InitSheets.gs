    [85058430, "رفيق ياسر أنور جوارجي"],
    [84495382, "يحيى أيمن محمد سيد"],
  ];

  // Write students (with empty Status and Completed_At columns)
  const studentRows = studentData.map(([id, name]) => [id, name, "", ""]);
  studentsSheet.getRange(2, 1, studentRows.length, 4).setValues(studentRows);

  // Format header
  studentsSheet.getRange(1, 1, 1, 4).setFontWeight("bold").setBackground("#4285f4").setFontColor("white");
  studentsSheet.setColumnWidth(1, 120);
  studentsSheet.setColumnWidth(2, 350);
  studentsSheet.setColumnWidth(3, 100);
  studentsSheet.setColumnWidth(4, 200);

  // ── 2. Tasks Sheet ─────────────────────────────────────────
  let tasksSheet = ss.getSheetByName("Tasks");
  if (!tasksSheet) tasksSheet = ss.insertSheet("Tasks");

  tasksSheet.clearContents();
  tasksSheet.getRange(1, 1, 1, 5).setValues([
    ["Task_Number", "Title", "Description", "Test_Input", "Expected_Output"]
  ]);

  const tasks = [
    [
      1,
      "Leap Year (compound conditions)",
      "Read a year and print whether it is a leap year.\nA year is a leap year if it is divisible by 4, except century years which must be divisible by 400.\n\nRequirements:\n- Combine conditions with && and ||\n- Print \"Leap year\" or \"Not a leap year\"\n- Hint: Test with 2024, 2023, 1900, 2000",
      "2000",
      "Leap year"
    ],
    [
      2,
      "Largest of Three (nested if)",
      "Read three integers and print the largest one without using Math.max.\nIf all three are equal, print \"All numbers are equal\".\n\nRequirements:\n- Use if statements only\n- Handle the case where two numbers are equal\n- Hint: Compare the first two, then the winner with the third\n\nSample Input: 8 15 3",
      "8 15 3",
      "Largest: 15"
    ],
    [
      3,
      "Simple ATM (switch + validation)",
      "Balance starts at 1000, PIN is 1234.\nAsk for PIN; if wrong print \"Wrong PIN\" and stop.\nIf correct, show: 1) Check balance  2) Withdraw  3) Exit\nWithdrawal must not exceed balance.\n\nRequirements:\n- Use switch for the menu\n- Print \"Insufficient balance\" when needed\n- Print the new balance after withdrawal\n\nSample: PIN=1234, Choice=2, Amount=300 → New balance: 700",
      "1234\n2\n300\n3",
      "New balance: 700"
    ],
    [
      4,
      "Star Triangle (nested loops)",
      "Read n and print a right-angled triangle of stars with n rows.\nRow i has i stars.\n\nRequirements:\n- Use an outer loop for rows\n- Use an inner loop for stars in each row\n\nSample: n=4",
      "4",
      "*\n**\n***\n****"
    ],
    [
      5,
      "Factorial (for loop + long)",
      "Read a number n and print n! (factorial).\nIf n is negative, print \"Invalid input\".\n\nRequirements:\n- Use a loop that multiplies a running result\n- Use long to hold large results\n\nSample: n=5 → 5! = 120",
      "5",
      "5! = 120"
    ],
    [
      6,
      "Prime Check (loop + break + flag)",
      "Read an integer n > 1 and print whether it is prime.\n\nRequirements:\n- Loop from 2 up to sqrt(n)\n- Use a boolean flag and break when a divisor is found\n\nSample: 17 → 17 is prime",
      "17",
      "17 is prime"
    ],
    [
      7,
      "Reverse and Palindrome (while + % and /)",
      "Read a positive integer.\nPrint its digits in reverse order and tell whether it is a palindrome.\n\nRequirements:\n- Extract digits with % 10\n- Remove digits with / 10 inside a while loop\n- Build reversed number: rev = rev*10 + digit\n\nSample: 121 → Reversed: 121, Palindrome",
      "121",
      "Reversed: 121\nPalindrome"
    ],
    [
      8,
      "FizzBuzz and Fibonacci (loops + conditions)",
      "Part A: Read n and print 1 to n.\nFor multiples of 3 print Fizz, multiples of 5 print Buzz, both print FizzBuzz.\n\nPart B: Print the first n Fibonacci numbers.\n\nRequirements:\n- Check FizzBuzz case first\n- Each number is sum of previous two\n\nSample: n=5 → 1, 2, Fizz, 4, Buzz",
      "5",
      "1\n2\nFizz\n4\nBuzz"
    ]
  ];

  tasksSheet.getRange(2, 1, tasks.length, 5).setValues(tasks);

  // Format tasks sheet
  tasksSheet.getRange(1, 1, 1, 5).setFontWeight("bold").setBackground("#34a853").setFontColor("white");
  tasksSheet.setColumnWidth(1, 120);
  tasksSheet.setColumnWidth(2, 250);
  tasksSheet.setColumnWidth(3, 450);
  tasksSheet.setColumnWidth(4, 150);
  tasksSheet.setColumnWidth(5, 200);

  SpreadsheetApp.getUi().alert(
    "✅ Done! Students (" + studentRows.length + ") and Tasks (8) sheets created successfully."
  );
}
